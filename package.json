{
  "name": "dsh-shark-bg",
  "version": "0.2.3",
  "private": true,
  "description": "在 Harness Web 界面背景中游动的 ASCII 鲨鱼",
  "type": "module",
  "main": "src/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iemgnod/dsh-shark-bg.git"
  },
  "homepage": "https://github.com/iemgnod/dsh-shark-bg#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "theme",
    "background",
    "ascii",
    "shark"
  ],
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./client": "./client/client.js",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "client",
    "docs",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "icon.svg",
    "screenshots.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "icon": "icon.svg",
  "scripts": {
    "pack": "npm pack --ignore-scripts"
  }
}
